{
	"name": "sistem-informasi-manajemen",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/components/ui/*/index.js": "./src/lib/components/ui/*/index.js",
		"#lib/components/ui/*": "./src/lib/components/ui/*/index.js",
		"#lib/customers/*": "./src/lib/customers/*.js",
		"#lib/inventory/*": "./src/lib/inventory/*.js",
		"#lib/maintenance/*": "./src/lib/maintenance/*.js",
		"#lib/returns/*": "./src/lib/returns/*.js",
		"#lib/transactions/*": "./src/lib/transactions/*.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:variants": "bun src/lib/inventory/variant-combinations.test.ts",
		"test:rentals": "bun src/lib/transactions/calculation.test.ts",
		"test:returns": "bun src/lib/returns/calculation.test.ts",
		"test:maintenance": "bun src/lib/maintenance/calculation.test.ts",
		"test:customers": "bun src/lib/customers/calculation.test.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.75.0",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"auth": "^1.7.25",
		"better-auth": "^1.7.25",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mode-watcher": "^1.1.0",
		"postgres": "^4.1.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	}
}
